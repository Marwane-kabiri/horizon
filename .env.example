# Copy this file to .env and fill in your own values:   cp .env.example .env
# NEVER commit the real .env file (it is listed in .gitignore).

PORT=3000
NODE_ENV=development

# postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://username:password@localhost:5432/horizon

# Set to true if your host requires SSL for the database (Render, Heroku, Supabase, Neon…)
DATABASE_SSL=false

# Signs the session cookie. Use a long random value — generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_secret
